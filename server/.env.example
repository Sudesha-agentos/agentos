# Copy to server/.env and fill in real values. Never commit secrets.

AWS_ACCESS_KEY_ID=
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Required in production. HMAC secret for session tokens (12h expiry).
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Dev-only backdoors — both are refused at boot when NODE_ENV=production.
# AUTH_ENABLE_DEMO_LOGIN=true
# AUTH_ALLOW_ANY_LOGIN=true

# Production (Render) — example values:
# CORS_ORIGIN=https://agentos-blue.vercel.app
# FRONTEND_URL=https://agentos-blue.vercel.app
# PUBLIC_API_URL=https://agentos-sc05.onrender.com

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=

# From Supabase → Connect (copy hostname exactly; may be aws-1 not aws-0). URL-encode password special chars.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require"


GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=""

# Bitbucket Cloud OAuth 2.0 consumer (Workspace Settings → OAuth consumers)
# Callback: {PUBLIC_API_URL}/api/git-integration/oauth/bitbucket/callback
# Recommended scopes: repository, repository:write, pullrequest, pullrequest:write, webhook
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
# BITBUCKET_OAUTH_REDIRECT_URI=
# BITBUCKET_OAUTH_STATE_SECRET=
# Legacy app-password fallback:
# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_WORKSPACE=
# BITBUCKET_REPO_SLUG=
# BITBUCKET_WEBHOOK_SECRET=

LLM_PROVIDER=openai
OPENAI_API_KEY=

LOG_LEVEL=info
NODE_ENV=development
PORT=4000

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {PUBLIC_API_URL}/api/auth/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_STATE_SECRET=

# Optional webhook to deliver password reset links (email service, Slack, etc.)
# PASSWORD_RESET_WEBHOOK_URL=

# Atlassian OAuth 3LO (Jira Cloud) — preferred connect method
# Atlassian OAuth (Jira Cloud) — also enable matching API scopes in Developer Console
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# After changing OAuth scopes in code, users must Disconnect + reconnect Jira in the app.
# Defaults to {PUBLIC_API_URL}/api/jira/oauth/callback
# ATLASSIAN_OAUTH_REDIRECT_URI=
# ATLASSIAN_OAUTH_STATE_SECRET=

# Legacy Jira API token (Basic auth fallback)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# GitNexus knowledge graph (vendored under server/vendor — PolyForm NC; see COMMERCIAL.md)
# Defaults to enabled. Set to 0 to skip graph analyze after index.
# CODEBASE_GITNEXUS_GRAPH=1
# CODEBASE_GITNEXUS_NATIVE=0
# CODEBASE_GRAPH_DATA_DIR=./data/graphs

# --- OSS tool adapters (CLI on host — do NOT vendor full upstream repos) ---
# Free tier (≤512MB): QA_OSS_ADAPTERS=0 = light mode (Hypothesis only).
# Also: CANARY_OSS_ADAPTERS=0, OSS_TOOLS_REQUIRED=0
# Build: pip install pytest hypothesis only (not full install-oss-tools.sh).
# QA_OSS_ADAPTERS=0
# CANARY_OSS_ADAPTERS=0
# OSS_TOOLS_REQUIRED=0
#
# Paid / ≥1GB full suite:
# QA_OSS_ADAPTERS=1
# CANARY_OSS_ADAPTERS=1
# OSS_TOOLS_REQUIRED=1
# + bash scripts/install-oss-tools.sh
# Probe: GET /api/integrations/oss-status (auth) or GET /healthz → ossTools
#
# Per-tool kills (when suite is fully on):
# QA_SEMGREP=0
# QA_PLAYWRIGHT=0
# QA_COVER_AGENT=0
# QA_HYPOTHESIS=0
# Semgrep: pip install semgrep
# Cover-Agent: pip install cover-agent
# Hypothesis: pip install pytest hypothesis
# Locust: pip install locust (default: server/vendor/locust/locustfile.py)
# QA_LOCUST=0 / CANARY_LOCUST=0
# ZAP: zap-baseline.py or docker pull ghcr.io/zaproxy/zaproxy:stable
# QA_ZAP=0 / CANARY_ZAP=0
# CANARY_LOCUST_CWD=/path/to/dir/with/locustfile.py
# QA_PLAYWRIGHT_BASE_URL=https://your-staging.example
# TOOL_ARTIFACTS_DATA_DIR=./data/tool-artifacts

# --- Virin research / discovery writeback ---
# VIRIN_WEB_RESEARCH=0          # disable DuckDuckGo/Jina web research
# VIRIN_JIRA_DISCOVERY_WRITEBACK=0  # disable posting questions/blockers to Jira
# VIRIN_BUG_LOGS=1              # force bug log pull even if LOG_INGESTION_ENABLED unset

# LOG_RETENTION_DAYS=30
# LOG_AI_ANALYSIS_ENABLED=1
# LOG_MAX_ENTRIES_PER_CYCLE=500
# 32-byte hex or any passphrase (hashed). Required in production — the API refuses to boot without it.
LOG_SOURCE_ENCRYPTION_KEY=

# Set to true to verify the Postgres TLS certificate (recommended when CA is configured).
# PG_SSL_REJECT_UNAUTHORIZED=true
# Optional Slack incoming webhook for production error alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PUBLIC_API_URL is used to build OTLP / custom / Sentry webhook URLs shown in the Sources UI.
