// Phase 1 — Pipeline schema.
// Layer 2 RAG now stores vectors in the SQL-managed `vector_store` table via
// Supabase RPC functions. That table intentionally lives outside Prisma because
// Prisma still cannot model pgvector cleanly enough for the similarity-search
// operators this project uses.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jiraTicketId   String
  jiraKey        String
  rawPayload     Json
  normalizedData Json
  status         TicketStatus
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pipeline       Pipeline?

  @@unique([organizationId, jiraTicketId])
  @@unique([organizationId, jiraKey])
  @@index([organizationId])
}

/// Canonical synced copy of Jira issues (all statuses in configured projects).
model JiraIssue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jiraTicketId   String
  jiraKey        String
  projectKey    String
  summary       String
  description   String    @db.Text
  issueType     String
  status        String
  priority      String?
  reporter      String?
  assignee      String?
  labels        Json      @default("[]")
  components    Json      @default("[]")
  commentsText  String?   @db.Text
  resolution    String?
  gitContext    String?   @db.Text
  rawPayload    Json?
  jiraUpdatedAt   DateTime?
  embeddedAt      DateTime?
  embedContentHash String?
  isDeleted       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([organizationId, jiraTicketId])
  @@unique([organizationId, jiraKey])
  @@index([organizationId])
  @@index([projectKey, status])
  @@index([jiraUpdatedAt])
  @@index([isDeleted])
}

model JiraSyncRun {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode          JiraSyncMode
  status        JiraSyncStatus
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  issuesSynced  Int             @default(0)
  issuesSkipped Int             @default(0)
  errors        Int             @default(0)
  errorMessage  String?         @db.Text
  watermark     DateTime?

  @@index([organizationId, status, startedAt])
}

/// Selective mirror of closed/done Jira issues for pipeline RAG (Lane 2).
/// @deprecated Prefer JiraIssue — kept for backward compatibility during migration.
model JiraMirror {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jiraTicketId   String
  jiraKey        String
  projectKey    String
  summary       String
  description   String    @db.Text
  issueType     String
  status        String
  priority      String?
  labels        Json      @default("[]")
  components    Json      @default("[]")
  commentsText  String?   @db.Text
  resolution    String?
  gitContext    String?   @db.Text
  embeddedAt    DateTime?
  jiraUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([organizationId, jiraTicketId])
  @@unique([organizationId, jiraKey])
  @@index([organizationId])
  @@index([status])
  @@index([projectKey])
  @@index([jiraUpdatedAt])
}

model PipelineQueueItem {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId       String
  jiraKey        String
  position       Int
  status         PipelineQueueStatus @default(PENDING)
  enqueuedAt     DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([organizationId, status, position])
  @@index([organizationId, jiraKey])
  @@index([ticketId])
}

model IntakeEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jiraKey        String
  source         String
  outcome        String
  skipReason     String?
  message        String?
  summary        String?
  issueType      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, jiraKey])
}

model PmAnalysisRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jiraKey        String
  recordJson     Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, jiraKey])
  @@index([organizationId, updatedAt])
}

model Pipeline {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId     String             @unique
  ticket       Ticket             @relation(fields: [ticketId], references: [id])
  currentStage PipelineStage
  status       PipelineStatus
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  stages       PipelineStageLog[]
  overrides    HumanOverride[]
  auditLogs    AuditLog[]
  canaryRuns   CanaryRun[]

  @@index([organizationId])
}

model CanaryRun {
  id           String          @id @default(cuid())
  pipelineId   String?
  pipeline     Pipeline?       @relation(fields: [pipelineId], references: [id])
  jiraKey      String?
  trigger      String          @default("manual")
  environment  String          @default("staging")
  scope        String          @default("full")
  targetUrl    String
  status       CanaryRunStatus @default(PENDING)
  phase        String?
  understanding Json?
  hypotheses   Json?
  summary      String?         @db.Text
  metadata     Json            @default("{}")
  error        String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  findings     CanaryFinding[]

  @@index([pipelineId])
  @@index([status, environment])
  @@index([jiraKey])
}

model CanaryFinding {
  id              String    @id @default(cuid())
  canaryRunId     String
  canaryRun       CanaryRun @relation(fields: [canaryRunId], references: [id], onDelete: Cascade)
  hypothesisId    String?
  severity        String
  category        String
  title           String
  description     String    @db.Text
  reproductionSteps String? @db.Text
  evidence        Json?
  affectedCode    String?
  suggestedFix    String?   @db.Text
  jiraKeyCreated  String?
  embeddedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([canaryRunId, severity])
}

model PipelineStageLog {
  id               String        @id @default(cuid())
  pipelineId       String
  pipeline         Pipeline      @relation(fields: [pipelineId], references: [id])
  stage            PipelineStage
  status           StageStatus
  input            Json
  output           Json?
  validationResult Json?
  confidenceScore  Float?
  tokenCount       Int?
  costUsd          Float?
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  error            String?

  @@index([pipelineId, stage])
}

model HumanOverride {
  id              String        @id @default(cuid())
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage
  originalOutput  Json
  correctedOutput Json
  reason          String?
  overriddenBy    String
  overriddenAt    DateTime      @default(now())

  @@index([pipelineId, stage])
}

model OrgIntelligenceRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceType String
  jiraKey    String
  pipelineId String?
  component  String?
  signal     String   @db.Text
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, jiraKey, createdAt])
  @@index([sourceType, createdAt])
  @@index([component])
}

model RetrievalLearningState {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  state          Json         @default("{}")
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model CompanyProfile {
  id              String        @id @default(cuid())
  organizationId  String?       @unique
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName     String        @default("")
  website         String        @default("")
  productSummary  String        @default("") @db.Text
  icp             String        @default("") @db.Text
  revenueModel    String        @default("") @db.Text
  pricingSummary  String        @default("") @db.Text
  businessContext String        @default("") @db.Text
  strategicGoals  Json          @default("[]")
  nonGoals        Json          @default("[]")
  competitors     Json          @default("[]")
  updatedAt       DateTime      @updatedAt
  updatedBy       String?
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String?
  googleId           String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        OrganizationMember[]
  onboarding         UserOnboarding?
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model UserOnboarding {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String    @default("")
  companyStage  String?
  teamSize      String?
  role          String?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

model Organization {
  id             String                  @id @default(cuid())
  name           String
  slug           String                  @unique
  domain         String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  members        OrganizationMember[]
  companyProfile CompanyProfile?
  jiraConfig     OrganizationJiraConfig?
  gitConfig      OrganizationGitConfig?
  billing        WorkspaceBilling?
  tickets        Ticket[]
  jiraIssues     JiraIssue[]
  jiraSyncRuns   JiraSyncRun[]
  jiraMirrors    JiraMirror[]
  pipelines      Pipeline[]
  pipelineQueueItems PipelineQueueItem[]
  intakeEvents   IntakeEvent[]
  pmAnalysisRecords PmAnalysisRecord[]
  orgIntelligence OrgIntelligenceRecord[]
  retrievalLearningState RetrievalLearningState?
  codebaseFiles  CodebaseFile[]
  codebaseIndexRuns CodebaseIndexRun[]
  codebaseVisualizationCaches CodebaseVisualizationCache[]
  codebaseTourCaches CodebaseTourCache[]
  codebaseKnowledgeCaches CodebaseKnowledgeCache[]
  branchStates   BranchState[]
  commitHistories CommitHistory[]
  githubInstallations GithubInstallation[]
  agentChatThreads AgentChatThread[]
  roadmap          Roadmap?
  logSources              LogSource[]
  errorPatterns           ErrorPattern[]
  anomalyDetections       AnomalyDetection[]
  logIntelligenceConfig   LogIntelligenceConfig?
  workspaceConnections    WorkspaceConnection[]
  canaryHypothesisLibrary CanaryHypothesisLibrary[]
  databases               OrganizationDatabase[]
  workBoard               WorkBoard?
  workItems               WorkItem[]

  @@index([domain])
}

model Roadmap {
  id             String         @id @default(cuid())
  organizationId String         @unique
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String         @default("Company roadmap")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  stages         RoadmapStage[]
  items          RoadmapItem[]
}

model RoadmapStage {
  id        String        @id @default(cuid())
  roadmapId String
  roadmap   Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  key       String
  label     String
  sortOrder Int
  items     RoadmapItem[]

  @@unique([roadmapId, key])
  @@index([roadmapId, sortOrder])
}

model RoadmapItem {
  id             String             @id @default(cuid())
  organizationId String
  roadmapId      String
  stageId        String
  slug           String
  title          String
  description    String?            @db.Text
  routeType      RoadmapRouteType   @default(USER_INPUT)
  status         RoadmapItemStatus  @default(PENDING)
  sortOrder      Int                @default(0)
  dependsOnSlugs Json               @default("[]")
  jiraKey        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  roadmap        Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  stage          RoadmapStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, slug])
  @@index([organizationId])
  @@index([roadmapId, stageId])
}

/// Org-scoped Kanban. Local cards use WB-n keys; Jira-synced cards use the Jira key.
model WorkBoard {
  id             String            @id @default(cuid())
  organizationId String            @unique
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String            @default("Work board")
  nextKeyNumber  Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  columns        WorkBoardColumn[]
  items          WorkItem[]
}

model WorkBoardColumn {
  id        String     @id @default(cuid())
  boardId   String
  board     WorkBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int
  isIntake  Boolean    @default(false)
  items     WorkItem[]

  @@unique([boardId, slug])
  @@index([boardId, sortOrder])
}

model WorkItem {
  id             String          @id @default(cuid())
  organizationId String
  boardId        String
  columnId       String
  key            String
  summary        String
  description    String          @default("") @db.Text
  issueType      String          @default("Task")
  priority       String          @default("Medium")
  assignee       String?
  labels         Json            @default("[]")
  sortOrder      Int             @default(0)
  source         String          @default("manual")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board          WorkBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column         WorkBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([boardId, columnId, sortOrder])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationGitConfig {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("github")
  workspace      String       @default("")
  repoSlug       String       @default("")
  username       String?
  token          String       @default("")
  webhookSecret  String       @default("")
  defaultBranch  String       @default("main")
  installationId String?
  authMethod     String       @default("pat")
  /// Bitbucket OAuth 2.0 (3-LO) token fields — mirrors OrganizationJiraConfig
  accessToken    String       @default("")
  refreshToken   String       @default("")
  tokenExpiresAt DateTime?
  scopes         String       @default("")
  updatedAt      DateTime     @updatedAt
}

model OrganizationJiraConfig {
  organizationId        String       @id
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseUrl               String       @default("")
  email                 String       @default("")
  apiToken              String       @default("")
  authMethod            String       @default("api_token")
  cloudId               String?
  accessToken           String       @default("")
  refreshToken          String       @default("")
  tokenExpiresAt        DateTime?
  scopes                String       @default("")
  webhookSecret         String       @default("")
  projectKeysJson       Json         @default("[]")
  boardId               String?
  aiWorkerColumnName    String?
  aiWorkerStatusesJson  Json?
  referenceColumnNamesJson Json?
  referenceStatusesJson Json?
  completionSettingsJson Json?
  updatedAt             DateTime     @updatedAt
}

/// Customer-owned databases attached to a workspace (many per org).
/// Passwords are AES-GCM encrypted at rest (same key as LogSource.config).
model OrganizationDatabase {
  id                    String   @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  /// postgresql | mysql | supabase
  provider              String
  /// development | staging | production
  environment           String   @default("staging")
  host                  String
  port                  Int
  databaseName          String
  username              String
  passwordEnc           Json
  ssl                   Boolean  @default(true)
  schemaAllowlist       Json     @default("[]")
  autoMigrate           Boolean  @default(false)
  requireConfirmToApply Boolean  @default(true)
  lastIntrospectedAt    DateTime?
  lastError             String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tables                OrganizationDatabaseTable[]
  migrations            OrganizationDatabaseMigration[]

  @@index([organizationId, provider])
  @@index([organizationId, environment])
}

model OrganizationDatabaseTable {
  id          String   @id @default(cuid())
  databaseId  String
  database    OrganizationDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  schemaName  String
  tableName   String
  columns     Json     @default("[]")
  primaryKeys Json     @default("[]")
  foreignKeys Json     @default("[]")
  indexes     Json     @default("[]")
  rowEstimate Int?
  updatedAt   DateTime @updatedAt

  @@unique([databaseId, schemaName, tableName])
  @@index([databaseId])
}

model OrganizationDatabaseMigration {
  id         String    @id @default(cuid())
  databaseId String
  database   OrganizationDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  pipelineId String?
  sql        String    @db.Text
  /// pending | applied | failed | awaiting_confirm
  status     String    @default("pending")
  error      String?   @db.Text
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([databaseId, createdAt])
  @@index([pipelineId])
}

model AgentChatThread {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentDomain String
  contextKey  String   @default("")
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    AgentChatMessage[]

  @@unique([organizationId, agentDomain, contextKey])
  @@index([organizationId, agentDomain])
}

model AgentChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    AgentChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  event      String
  metadata   Json
  timestamp  DateTime @default(now())

  @@index([pipelineId, timestamp])
}

model CodebaseVisualizationCache {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner   String
  repoName    String
  branchName  String
  layoutJson  Json
  computedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, repoOwner, repoName, branchName])
  @@index([organizationId, computedAt])
}

model CodebaseTourCache {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner   String
  repoName    String
  branchName  String
  tourJson    Json
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, repoOwner, repoName, branchName])
}

model CodebaseKnowledgeCache {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner     String
  repoName      String
  branchName    String
  knowledgeJson Json
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, repoOwner, repoName, branchName])
}

model CodebaseFile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner     String
  repoName      String
  filePath      String
  branchName    String
  content       String   @db.Text
  contentHash   String
  size          Int
  language      String?
  summary       String?  @db.Text
  exports       Json
  imports       Json
  patterns      Json
  lastCommitSha String?
  lastCommitMsg String?
  lastCommitAt  DateTime?
  lastAuthor    String?
  indexedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  @@unique([organizationId, repoOwner, repoName, filePath, branchName])
  @@index([organizationId, repoOwner, repoName, branchName])
  @@index([language])
  @@index([contentHash])
}

model BranchState {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner    String
  repoName     String
  branchName   String
  sourceBranch String
  jiraKey      String?
  createdBy    String
  headSha      String
  behindBy     Int      @default(0)
  aheadBy      Int      @default(0)
  prNumber     Int?
  prUrl        String?
  prStatus     String?
  filesChanged Json
  lastPushAt   DateTime?
  lastPushBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([organizationId, repoOwner, repoName, branchName])
  @@index([organizationId, jiraKey])
}

model CommitHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner     String
  repoName      String
  branchName    String
  sha           String
  message       String
  author        String
  authoredAt    DateTime
  filesAdded    Json
  filesModified Json
  filesDeleted  Json
  pushedBy      String
  pipelineId    String?
  jiraKey       String?
  createdAt     DateTime @default(now())

  @@unique([organizationId, repoOwner, repoName, sha])
  @@index([organizationId, branchName])
  @@index([organizationId, jiraKey])
}

model CodebaseIndexRun {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repoOwner       String
  repoName        String
  branchName      String
  runType         String
  status          String
  filesTotal      Int      @default(0)
  filesProcessed  Int      @default(0)
  filesIndexed    Int      @default(0)
  filesUpdated    Int      @default(0)
  filesDeleted    Int      @default(0)
  triggerType     String
  triggerSha      String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  error           String?

  @@index([organizationId, repoOwner, repoName, status])
  @@index([organizationId, startedAt])
}

model WorkspaceBilling {
  id             String        @id @default(cuid())
  organizationId String        @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String        @default("pilot")
  runsUsed       Int           @default(0)
  runsCap        Int           @default(20)
  pilotEndsAt    DateTime?
  billingCycle   String        @default("monthly")
  updatedAt      DateTime      @updatedAt
}

model GithubInstallation {
  id                String             @id @default(cuid())
  organizationId    String?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  installationId    String             @unique
  accountLogin      String
  accountType       String
  targetType        String?
  permissionsJson   Json?
  eventsJson        Json?
  suspendedAt       DateTime?
  selectedRepoOwner String?
  selectedRepoName  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  repositories      GithubRepository[]

  @@index([accountLogin])
  @@index([organizationId])
}

model GithubRepository {
  id             String             @id @default(cuid())
  installationId String
  githubRepoId   Int
  owner          String
  name           String
  fullName       String
  defaultBranch  String             @default("main")
  private        Boolean            @default(false)
  selected       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  installation   GithubInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@unique([installationId, githubRepoId])
  @@index([fullName])
  @@index([installationId, selected])
}

