{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.agentox.io" }],
      "destination": "https://agentox.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agentox.io" }],
      "destination": "https://agentox.io/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "agentos-blue.vercel.app" }],
      "destination": "https://agentox.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "agentos-blue.vercel.app" }],
      "destination": "https://agentox.io/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!googled413b182387f254c\\.html$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
